# Copy to backend/.env and fill in. Never commit backend/.env.

APP_ENV=development

# Signs session cookies. Use at least 32 random characters, for example:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=

# OAuth 2.0 Web client ID from Google Cloud Console (ends in .apps.googleusercontent.com).
# This is not the Gemini GOOGLE_API_KEY. See docs/AUTHENTICATION.md.
GOOGLE_OAUTH_CLIENT_ID=

# Comma-separated browser origins allowed to sign in and out.
FRONTEND_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Session lifetime in seconds (default 7 days).
SESSION_TTL_SECONDS=604800
